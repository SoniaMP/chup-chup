{
  "expo": {
    "name": "Chup Chup",
    "slug": "chup-chup",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "chupchup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "es.chupchup.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chup Chup usa tus fotos para ponerle cara a tus recetas.",
          "cameraPermission": "Chup Chup usa la cámara para hacerle una foto a lo que cocinas.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6EFE4"
    },
    "android": {
      "package": "es.chupchup.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6EFE4"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "75ac59f9-b001-4be1-86fb-3d886d21150b"
      }
    },
    "owner": "sonhjas-team"
  }
}
