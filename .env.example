# Copy this file to .env and fill it in with the values from
# Supabase -> Project Settings -> API keys.
# Both values are safe to ship in the app: what protects the data is RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the shared-recipe viewer is served from, with no trailing slash:
# https://chup-chup.es once nginx is up. Leave it empty and links fall back to the
# Edge Function URL, which works but renders as plain text (*.supabase.co won't serve HTML).
EXPO_PUBLIC_SHARE_BASE_URL=
